#!/bin/sh
export DISPLAY=:0

# 1. Monocle / Workspace setup
bspc monitor -d 1 2 3 4

# 2. Window borders, gaps, and mobile split scheme
bspc config border_width         2
bspc config window_gap           2
bspc config split_ratio          0.50
bspc config automatic_scheme     longest_side
bspc config initial_polarity     second_child
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config single_monocle       false

# Colors (TokyoNight Cyberdeck)
bspc config normal_border_color   #24283b
bspc config active_border_color   #414868
bspc config focused_border_color  #7aa2f7
bspc config presel_feedback_color #bb9af7

# Padding for Top Status Bar (36px) and Bottom Task Bar (42px)
bspc config top_padding    36
bspc config bottom_padding 42

# Default to Monocle (Full-Screen per app, like Android/Phosh)
bspc desktop -l monocle
echo "monocle" > /tmp/prev_bspwm_layout

# 3. Rules:
# Keyboard: split south, 32% height (0.68 for primary app), don't steal focus
bspc rule -a matchbox-keyboard state=tiled split_dir=south split_ratio=0.68 focus=off
bspc rule -a onboard state=tiled split_dir=south split_ratio=0.68 focus=off
bspc rule -a matchbox-keyboard-image state=tiled split_dir=south split_ratio=0.68 focus=off

# Panels and dialogs:
bspc rule -a Tint2 manage=off
bspc rule -a tint2 manage=off
bspc rule -a Rofi state=floating
bspc rule -a svkbd-mobile-intl manage=off
bspc rule -a Svkbd manage=off
bspc rule -a svkbd manage=off
