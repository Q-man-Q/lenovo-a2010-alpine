#!/bin/sh
export DISPLAY=:0
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

CHOICE=$(printf "🌙 Сон (Screen Off)\n🔄 Перезагрузить (Reboot)\n⚡ Выключить (Power Off)\n✕ Отмена" | sxmo_dmenu.sh -p "Питание")

case "$CHOICE" in
    *"Сон"*)
        sxmo_state.sh set screenoff
        ;;
    *"Перезагрузить"*)
        sync
        echo 0 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null || true
        /sbin/reboot -f 2>/dev/null || /bin/busybox reboot -f
        ;;
    *"Выключить"*)
        sync
        echo 0 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null || true
        /sbin/poweroff -f 2>/dev/null || /bin/busybox poweroff -f
        ;;
esac
