#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""
CyberPlay — Ultra-Lightweight Touch Video & Audio Player for Lenovo A2010 (480x854)
Built with Python 3 + GTK 3 + GStreamer 1.0 (GstVideo.VideoOverlay + ximagesink)
Features:
  - Direct X11 video surface embedding (zero GL/compositor overhead)
  - Tap video area to Play / Pause
  - Big thumb buttons: Open File, -10s, Play/Pause, +10s, Loop
  - Touch seek slider with live MM:SS position / duration
"""
import os
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
gi.require_version("Gst", "1.0")
gi.require_version("GstVideo", "1.0")
from gi.repository import Gtk, Gdk, GdkX11, Gst, GstVideo, GLib

Gst.init(None)

CSS = b"""
window {
    background-color: #1a1b26;
    color: #c0caf5;
    font-family: Sans;
}
.header-bar {
    background-color: #16161e;
    border-bottom: 1px solid #24283b;
    padding: 4px 6px;
}
.title-lbl {
    font-size: 11px;
    font-weight: bold;
    color: #7dcfff;
}
.video-area {
    background-color: #000000;
}
.controls-box {
    background-color: #16161e;
    border-top: 1px solid #24283b;
    padding: 6px;
}
.ctrl-btn {
    background-color: #24283b;
    color: #c0caf5;
    font-size: 14px;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px 12px;
    border: 1px solid #414868;
}
.ctrl-btn:active {
    background-color: #3d59a1;
}
.play-btn {
    background-color: #3d59a1;
    color: #ffffff;
