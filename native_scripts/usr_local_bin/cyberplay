    padding: 8px 16px;
    border: 1px solid #7aa2f7;
}
.close-btn {
    background-color: #24283b;
    color: #f7768e;
    font-size: 13px;
    font-weight: bold;
    border-radius: 8px;
    padding: 6px 10px;
    border: 1px solid #414868;
}
