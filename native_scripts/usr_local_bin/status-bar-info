#!/bin/sh
# Top Status Bar Telemetry (Android / Phosh style for Tint2 execp)

# 1. Battery
BAT_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "")
BAT_STAT=$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo "")
if [ -n "$BAT_CAP" ]; then
    if [ "$BAT_STAT" = "Charging" ] || [ "$BAT_STAT" = "Full" ]; then
        BAT_STR="⚡${BAT_CAP}%"
    else
        BAT_STR="🔋${BAT_CAP}%"
    fi
else
    BAT_STR="⚡USB"
fi

# 2. CPU Temp (MediaTek thermal_zone0 / mtktscpu is in millidegrees)
TEMP_RAW=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || cat /sys/class/thermal/thermal_zone1/temp 2>/dev/null)
if [ -n "$TEMP_RAW" ] && [ "$TEMP_RAW" -gt 1000 ] 2>/dev/null; then
    TEMP_STR="🌡$((TEMP_RAW / 1000))°C"
else
    TEMP_STR=""
fi

# 3. RAM & Swap used (MB)
RAM_USED=$(free -m 2>/dev/null | awk '/buffers\/cache:/ {print $3}')
[ -z "$RAM_USED" ] && RAM_USED=$(free -m 2>/dev/null | awk '/^Mem:/ {print $3}')
SWAP_USED=$(free -m 2>/dev/null | awk '/^Swap:/ {print $3}')
RAM_STR="🧠${RAM_USED:-50}M"
if [ -n "$SWAP_USED" ] && [ "$SWAP_USED" -gt 0 ] 2>/dev/null; then
    RAM_STR="${RAM_STR} 🔄${SWAP_USED}M"
fi

echo "${BAT_STR}  ${TEMP_STR}  ${RAM_STR}"
