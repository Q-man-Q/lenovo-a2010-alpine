#!/usr/bin/env python3
"""
Lenovo A2010a (MT6735M + MT6328 PMIC) Native ALSA Audio Router & Unmuter
Uses libasound.so.2 directly via ctypes (zero external dependencies).

Usage:
  setup-audio [speaker|headset|receiver|mute|toggle|dump|test]
"""
import ctypes
import glob
import os
import stat
import sys

STATE_FILE = '/tmp/audio_route'

def ensure_snd_nodes():
    os.makedirs('/dev/snd', exist_ok=True)
    for dev_file in glob.glob('/sys/class/sound/*/dev'):
        try:
            name = os.path.basename(os.path.dirname(dev_file))
            node_path = f'/dev/snd/{name}'
            if not os.path.exists(node_path):
                with open(dev_file, 'r') as f:
                    maj, min_ = map(int, f.read().strip().split(':'))
                os.mknod(node_path, stat.S_IFCHR | 0o666, os.makedev(maj, min_))
        except Exception:
            pass

def configure_asound_conf():
    """Detect MediaTek I2S0DL1_PLayback (or MultiMedia1_PLayback) in /proc/asound/pcm and write /etc/asound.conf."""
    i2s0dl1_dev = None
    dl1_dev = 0
    try:
        if os.path.exists('/proc/asound/pcm'):
            with open('/proc/asound/pcm', 'r') as f:
                for line in f:
                    # Format: 00-14: I2S0DL1_PLayback ...
                    parts = line.strip().split(':')
                    if len(parts) >= 2:
                        dev_str = parts[0].split('-')[-1]
                        if dev_str.isdigit():
                            dev_num = int(dev_str)
                            if 'I2S0DL1_PLayback' in line:
                                i2s0dl1_dev = dev_num
                            elif 'MultiMedia1_PLayback' in line:
                                dl1_dev = dev_num
    except Exception:
        pass

    target_dev = dl1_dev
    conf = f"""# Auto-generated by setup-audio for Lenovo A2010 (MT6735 mt_soc_audio_v3)
pcm.!default {{
    type asym
    playback.pcm {{
        type plug
        slave.pcm {{
            type hw
            card 0
            device {target_dev}
        }}
    }}
    capture.pcm {{
        type plug
        slave.pcm {{
            type hw
            card 0
            device 1
        }}
    }}
}}

ctl.!default {{
    type hw
    card 0
}}
"""
    try:
        with open('/etc/asound.conf', 'w') as f:
            f.write(conf)
    except Exception:
        pass

class AlsaCtl:
    def __init__(self, card=b'hw:0'):
        self.lib = ctypes.CDLL('libasound.so.2')
        self.ctl = ctypes.c_void_p()
        rc = self.lib.snd_ctl_open(ctypes.byref(self.ctl), card, 0)
        if rc < 0:
            raise RuntimeError(f'snd_ctl_open failed: {rc}')

    def close(self):
        if self.ctl:
            self.lib.snd_ctl_close(self.ctl)
            self.ctl = None

    def cset(self, name, val_str):
        elem_id = ctypes.create_string_buffer(256)
        info = ctypes.create_string_buffer(512)
        value = ctypes.create_string_buffer(2048)

        id_spec = f'iface=MIXER,name="{name}"'.encode('ascii')
        if self.lib.snd_ctl_ascii_elem_id_parse(elem_id, id_spec) < 0:
            return False

        self.lib.snd_ctl_elem_info_set_id(info, elem_id)
        if self.lib.snd_ctl_elem_info(self.ctl, info) < 0:
            return False

        self.lib.snd_ctl_elem_value_set_id(value, elem_id)
        self.lib.snd_ctl_elem_read(self.ctl, value)

        if self.lib.snd_ctl_ascii_value_parse(self.ctl, value, info, str(val_str).encode('ascii')) < 0:
            return False

        return self.lib.snd_ctl_elem_write(self.ctl, value) >= 0

    def dump_controls(self):
        # Fallback if amixer is installed: run amixer contents
        if os.path.exists('/usr/bin/amixer'):
            os.system('/usr/bin/amixer -c 0 contents | tee /var/log/alsa_controls.log')
            return

        # Probe known MT6735 / MT6328 controls
        known = [
            'AUD_CLK_BUF_Switch',
            'Audio_Amp_L_Switch',
            'Audio_Amp_R_Switch',
            'Ext_Speaker_Amp_Switch',
            'Headset_Speaker_Amp_Switch',
            'Voice_Amp_Switch',
            'Receiver_Speaker_Switch',
            'Audio_Speaker_class_Switch',
            'Audio_Speaker_PGA_gain',
            'Headset_PGAL_GAIN',
            'Headset_PGAR_GAIN',
            'Handset_PGA_GAIN',
            'Lineout_PGAL_GAIN',
            'Lineout_PGAR_GAIN',
            'Audio_I2S0dl1_hd_Switch',
            'Audio_i2s0_hd_Switch',
        ]
        lines = []
        for k in known:
            elem_id = ctypes.create_string_buffer(256)
            info = ctypes.create_string_buffer(512)
            id_spec = f'iface=MIXER,name="{k}"'.encode('ascii')
            if self.lib.snd_ctl_ascii_elem_id_parse(elem_id, id_spec) == 0:
                self.lib.snd_ctl_elem_info_set_id(info, elem_id)
                present = (self.lib.snd_ctl_elem_info(self.ctl, info) == 0)
                lines.append(f'{k}: {"FOUND" if present else "missing"}')
        out = '\n'.join(lines)
        print(out)
        try:
            with open('/var/log/alsa_controls.log', 'w') as f:
                f.write(out + '\n')
        except Exception:
            pass

def apply_route(mode):
    ensure_snd_nodes()
    configure_asound_conf()
    try:
        ctl = AlsaCtl()
    except Exception as e:
        print(f'ALSA init warning: {e}', file=sys.stderr)
        return

    try:
        # Always enable audio clock buffer and mic ADC/Preamp on MT6328
        ctl.cset('AUD_CLK_BUF_Switch', 'On')
        ctl.cset('Audio_ADC_1_Switch', 'Off')
        ctl.cset('Audio_ADC_2_Switch', 'Off')
        ctl.cset('Audio_ADC_1_Sel', 'Preamp')
        ctl.cset('Audio_ADC_2_Sel', 'Preamp')
        ctl.cset('Audio_MIC1_Mode_Select', 'DCCECMDIFFMODE')
        ctl.cset('Audio_MIC2_Mode_Select', 'DCCECMDIFFMODE')
        ctl.cset('Audio_MicSource1_Setting', 'ADC1')
        ctl.cset('Audio_ADC_1_Switch', 'On')
        ctl.cset('Audio_ADC_2_Switch', 'On')
        ctl.cset('Audio_Preamp1_Switch', 'IN_ADC1')
        ctl.cset('Audio_Preamp2_Switch', 'IN_ADC1')
        ctl.cset('Audio_PGA1_Setting', '30Db')
        ctl.cset('Audio_PGA2_Setting', '30Db')

        if mode == 'speaker':
            ctl.cset('Voice_Amp_Switch', 'Off')
            ctl.cset('Receiver_Speaker_Switch', 'Off')
            ctl.cset('Ext_Speaker_Amp_Switch', 'Off')
            ctl.cset('Headset_Speaker_Amp_Switch', 'Off')
            ctl.cset('Audio_Amp_L_Switch', 'Off')
            ctl.cset('Audio_Amp_R_Switch', 'Off')
            ctl.cset('Audio_Speaker_class_Switch', 'CLASSAB')
            ctl.cset('Audio_Speaker_PGA_gain', '17Db')
            ctl.cset('Speaker_Amp_Switch', 'On')

        elif mode == 'headset':
            ctl.cset('Speaker_Amp_Switch', 'Off')
            ctl.cset('Ext_Speaker_Amp_Switch', 'Off')
            ctl.cset('Headset_Speaker_Amp_Switch', 'Off')
            ctl.cset('Voice_Amp_Switch', 'Off')
            ctl.cset('Receiver_Speaker_Switch', 'Off')
            ctl.cset('Headset_PGAL_GAIN', '0Db')
            ctl.cset('Headset_PGAR_GAIN', '0Db')
            ctl.cset('Audio_Amp_L_Switch', 'On')
            ctl.cset('Audio_Amp_R_Switch', 'On')

        elif mode == 'receiver':
            ctl.cset('Speaker_Amp_Switch', 'Off')
            ctl.cset('Ext_Speaker_Amp_Switch', 'Off')
            ctl.cset('Headset_Speaker_Amp_Switch', 'Off')
            ctl.cset('Audio_Amp_L_Switch', 'Off')
            ctl.cset('Audio_Amp_R_Switch', 'Off')
            ctl.cset('Audio_Speaker_class_Switch', 'RECEIVER')
            ctl.cset('Handset_PGA_GAIN', '8Db')
            ctl.cset('Receiver_Speaker_Switch', 'On')
            ctl.cset('Voice_Amp_Switch', 'On')

        elif mode == 'mute':
            ctl.cset('Speaker_Amp_Switch', 'Off')
            ctl.cset('Ext_Speaker_Amp_Switch', 'Off')
            ctl.cset('Headset_Speaker_Amp_Switch', 'Off')
            ctl.cset('Audio_Amp_L_Switch', 'Off')
            ctl.cset('Audio_Amp_R_Switch', 'Off')
            ctl.cset('Voice_Amp_Switch', 'Off')
            ctl.cset('Receiver_Speaker_Switch', 'Off')
    finally:
        ctl.close()

    try:
        with open(STATE_FILE, 'w') as f:
            f.write(mode)
    except Exception:
        pass
    print(f'Audio route set to: {mode}')

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'speaker'
    if cmd == 'dump':
        ensure_snd_nodes()
        ctl = AlsaCtl()
        ctl.dump_controls()
        ctl.close()
        return

    if cmd == 'toggle':
        cur = 'speaker'
        try:
            with open(STATE_FILE, 'r') as f:
                cur = f.read().strip()
        except Exception:
            pass
        order = ['speaker', 'headset', 'mute']
        nxt = order[(order.index(cur) + 1) % len(order)] if cur in order else 'speaker'
        apply_route(nxt)
        return

    if cmd in ('speaker', 'headset', 'receiver', 'mute'):
        apply_route(cmd)
    else:
        apply_route('speaker')

if __name__ == '__main__':
    main()
