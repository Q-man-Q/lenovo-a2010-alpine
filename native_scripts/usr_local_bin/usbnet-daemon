#!/bin/sh
# Lenovo A2010 Native Linux USB RNDIS Daemon
exec >> /var/log/usbnet.log 2>&1

setup_gadget() {
    if [ -d /sys/class/android_usb/android0 ]; then
        echo 0 > /sys/class/android_usb/android0/enable 2>/dev/null || true
        echo 17EF > /sys/class/android_usb/android0/idVendor 2>/dev/null || true
        echo 2004 > /sys/class/android_usb/android0/idProduct 2>/dev/null || true
        echo MediaTek > /sys/class/android_usb/android0/iManufacturer 2>/dev/null || true
        echo A2010-a > /sys/class/android_usb/android0/iProduct 2>/dev/null || true
        echo A2010-ALPINE > /sys/class/android_usb/android0/iSerial 2>/dev/null || true
        echo 1 > /sys/class/android_usb/android0/f_rndis/wceis 2>/dev/null || true
        echo Lenovo > /sys/class/android_usb/android0/f_rndis/manufacturer 2>/dev/null || true
        echo 17EF > /sys/class/android_usb/android0/f_rndis/vendorID 2>/dev/null || true
        echo rndis > /sys/class/android_usb/android0/functions 2>/dev/null || true
        echo 224 > /sys/class/android_usb/android0/bDeviceClass 2>/dev/null || true
        echo 1 > /sys/class/android_usb/android0/enable 2>/dev/null || true
    fi
}

MODE=$(cat /tmp/usb_mode 2>/dev/null || echo "rndis")
if [ "$MODE" = "rndis" ]; then
    setup_gadget
fi

while true; do
    MODE=$(cat /tmp/usb_mode 2>/dev/null || echo "rndis")
    if [ "$MODE" = "flash" ]; then
        sleep 2
        continue
    fi
    FUNCS=$(cat /sys/class/android_usb/android0/functions 2>/dev/null)
    EN=$(cat /sys/class/android_usb/android0/enable 2>/dev/null)
    if [ "$FUNCS" != "rndis" ] || [ "$EN" != "1" ]; then
        setup_gadget
        sleep 1
    fi
    if [ -d /sys/class/net/rndis0 ]; then
        if ! ip -4 addr show rndis0 2>/dev/null | grep -q "10.42.0.2"; then
            ip link set rndis0 up 2>/dev/null || true
            ip addr add 10.42.0.2/24 dev rndis0 2>/dev/null || true
            ip addr add 192.168.42.129/24 dev rndis0 2>/dev/null || true
            ip route replace default via 10.42.0.1 dev rndis0 2>/dev/null || true
            echo "nameserver 1.1.1.1" > /etc/resolv.conf
            echo "nameserver 8.8.8.8" >> /etc/resolv.conf
            ping -c 1 -W 1 10.42.0.1 >/dev/null 2>&1 || true
        fi
    fi
    sleep 2
done
